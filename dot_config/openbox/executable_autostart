#!/bin/sh
#
# Openbox per-user autostart.
# Runs once when the Openbox session starts (via ~/.xinitrc -> openbox-session).
#
# Every block is guarded with `command -v`, so this file is safe to keep as-is
# even if none of the optional packages are installed. Nothing here is required
# for Openbox to run.
#
# Changes take effect on the next session ("openbox --reconfigure" does NOT
# re-run this file).

# ---------------------------------------------------------------- wallpaper --
# Preference order:
#   1. ~/.fehbg          - written by `feh --bg-fill <img>`; restores last choice
#   2. ~/.config/openbox/wallpaper - a symlink or image you drop in yourself
#   3. a flat colour, so the root window is never the default grey stipple
if [ -x "$HOME/.fehbg" ]; then
  "$HOME/.fehbg" &
elif command -v feh >/dev/null 2>&1 && [ -f "$HOME/.config/openbox/wallpaper" ]; then
  feh --no-fehbg --bg-fill "$HOME/.config/openbox/wallpaper" &
elif command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid "#1d2021" &
fi

# -------------------------------------------------------------------- panel --
# tint2 is a taskbar/systray. It sets struts, which Openbox honours, so maximised
# windows stop short of it. Fullscreen games ignore struts and still cover it.
if command -v tint2 >/dev/null 2>&1; then
  tint2 &
fi

# --------------------------------------------------------------- compositor --
# Deliberately NOT started. picom adds a frame of latency and can cause tearing
# or stutter in fullscreen games, and this session exists to run Steam. Enable
# only if you want transparency/shadows more than you want frame timing:
#
#   command -v picom >/dev/null 2>&1 && picom -b &

# ----------------------------------------------------------------- polkit ----
# Lets GUI apps request privileges (e.g. mounting drives) without a terminal.
for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
             /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1; do
  if [ -x "$agent" ]; then
    "$agent" &
    break
  fi
done

# ------------------------------------------------------------ gtk theming ----
# Applies the GTK theme/font/cursor you pick in lxappearance. Without a settings
# daemon, GTK apps fall back to the raw default theme.
if command -v xsettingsd >/dev/null 2>&1; then
  xsettingsd &
fi

# ---------------------------------------------------------------- keyring ----
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)"
  export SSH_AUTH_SOCK
fi

# ------------------------------------------------------------------ notify ----
# Steam and Firefox both send desktop notifications; without a daemon they are
# silently dropped.
if command -v dunst >/dev/null 2>&1; then
  dunst &
fi
