# Machine-local state and secrets — never manage these.
.cache
.claude.json
.claude/*
!.claude/settings.json
.config/elinks
.config/autostart
.config/fish/fish_variables
.local/share/fish/fish_history
.local/share/applications
.viminfo
.lesshst

# micro ships/downloads these; only settings.json is ours.
.config/micro/syntax
.config/micro/colorschemes

# Repo docs, not a dotfile.
README.md

# tpm clones plugin repos here; managed by run_once_install-tpm.sh.
.config/tmux/plugins

# Openbox writes timestamped backups next to the live files.
.config/openbox/*.bak
.config/openbox/*.bak-*
.config/openbox/*.orig
.config/openbox/*.pre-*

# Regenerated from obmenu-generator/schema.pl on every run; schema.pl is ours.
.config/openbox/menu.xml
.config/obmenu-generator/*.orig

# Credentials and machine-local state.
.config/gh
.config/chezmoi
.config/go
.config/mozilla
.config/yay

# App-written, currently all defaults - nothing of ours to keep.
.config/btop
.config/ghostty

# Distro-specific symlink into /usr/share; autostart falls back without it.
.config/openbox/wallpaper

# Empty directories other packages created.
.config/menus
.config/procps

# Neovim's own state: swap, undo, shada, lazy/mason downloads. Only
# .config/nvim/init.lua is ours.
.local/share/nvim
.local/state/nvim

{{ if ne .chezmoi.os "linux" }}
# ---------------------------------------------------------------------------
# Linux-only. This repo grew up on a CachyOS box; the desktop session and the
# Arch-flavoured bash config are meaningless (or actively wrong) elsewhere.
# ---------------------------------------------------------------------------

# Openbox window manager, its panel and its menu generator.
.config/openbox
.config/obmenu-generator
.config/tint2

# XDG desktop file associations; macOS uses LaunchServices.
.config/mimeapps.list

# The fish config sources /usr/share/cachyos-fish-config/cachyos-config.fish,
# which only exists on that distro. fish itself is portable; this config is not.
.config/fish

# Arch's default .bashrc: 'ls --color=auto' is a GNU flag that BSD ls
# rejects. The macOS .bash_profile sources ~/.bashrc only if it exists,
# so leaving it unmanaged here is safe.
.bashrc
{{ end }}
