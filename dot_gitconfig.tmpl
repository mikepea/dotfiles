[user]
	name = Mike Pountney
	email = Mike.Pountney@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
{{ if eq .chezmoi.os "darwin" }}
# macOS only, carried over from the pre-chezmoi ~/.gitconfig on that machine.
# This block must come *before* the per-host credential blocks below. Those
# reset the helper list for github with an empty 'helper =', so a global
# helper declared after them would simply be appended back on, defeating the
# reset. Declared here, it applies to every other host and not to github.
[core]
	editor = /usr/bin/vim

[credential]
	helper = osxkeychain

# Rewrite SSH remotes to HTTPS so the gh credential helper below is what
# authenticates, rather than needing an SSH key on this machine.
[url "https://github.com/"]
	insteadOf = git@github.com:
{{- end }}
{{ if lookPath "gh" }}
# Wired up by 'gh auth setup-git'. The empty 'helper =' clears anything
# inherited from system config, so gh is the only helper consulted for these
# hosts. Deliberately unqualified where gh writes an absolute path: it is in
# /usr/bin on this box but /opt/homebrew/bin, ~/.nix-profile/bin or
# /usr/local/bin elsewhere. git runs a '!' helper through the shell, so PATH
# resolves it. The block is omitted entirely on a machine without gh.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
